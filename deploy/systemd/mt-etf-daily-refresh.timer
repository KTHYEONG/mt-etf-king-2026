[Unit]
Description=Run mt-etf-daily-refresh on weekdays with Saturday catch-up (KST)

[Timer]
# T일 KRX 데이터는 T+1 오전에 게시되므로 아침 슬롯이 당일분을 메운다.
# 아침 슬롯은 공동 테넌트 kca-auction-open의 장 시작가 캡처(08:39:55~09:03 KST)를
# 피해야 한다: 08:30 슬롯은 그 전에 끝나야 하고, 다음 슬롯은 09:03 이후에
# 시작한다. AccuracySec은 슬롯 시작 시각의 지터 상한이다.
#
# 휴장일이나 신규 게시가 없는 실행은 직전 세션을 타깃으로 삼고, ingest를
# 건너뛰고, silver/feature 재기록 없이 종료한다(rc=0). ETF 세션이 인덱스에는
# 있는데 ETF silver에 없는 stale gap이 있으면 실패로 종료한다(rc=1).
OnCalendar=*-*-* 08:30:00 Asia/Seoul
OnCalendar=*-*-* 08:35:00 Asia/Seoul
OnCalendar=*-*-* 09:05:00 Asia/Seoul
OnCalendar=Sat *-*-* 11:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 16:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 20:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 22:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 23:30:00 Asia/Seoul
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
